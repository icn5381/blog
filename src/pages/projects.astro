---
import { getCollection } from "astro:content";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const projects = (await getCollection("projects", ({ data }) => data.draft !== true)).sort(
	(a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
---
<MainGridLayout title="项目" description="我在做的东西">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
            <h1 class="text-3xl font-bold mb-2 text-black/90 dark:text-white/90" style="font-family: 'Noto Serif SC', serif;">项目</h1>
            <p class="text-black/50 dark:text-white/50 mb-6">在做的东西、做过的东西。</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {projects.map((p) => (
                <div class="rounded-xl border border-black/10 dark:border-white/10 p-5 flex flex-col gap-2 transition hover:border-[var(--primary)]">
                    <div class="flex items-center justify-between gap-2">
                        <h2 class="text-lg font-bold text-black/90 dark:text-white/90">{p.data.title}</h2>
                        <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--btn-regular-bg)] text-black/60 dark:text-white/60 whitespace-nowrap">{p.data.status}</span>
                    </div>
                    <p class="text-sm text-black/60 dark:text-white/60 flex-1">{p.data.description}</p>
                    <div class="flex flex-wrap gap-1.5">
                        {p.data.tech.map((t) => (
                        <span class="text-xs px-2 py-0.5 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50">{t}</span>
                        ))}
                    </div>
                    <div class="flex gap-3 text-sm">
                        {p.data.url && p.data.url !== "/" && <a href={p.data.url} class="text-[var(--primary)] hover:underline" target="_blank" rel="noopener">在线访问 ↗</a>}
                        {p.data.repo && <a href={p.data.repo} class="text-[var(--primary)] hover:underline" target="_blank" rel="noopener">源码 ↗</a>}
                    </div>
                </div>
                ))}
            </div>
        </div>
    </div>
</MainGridLayout>
