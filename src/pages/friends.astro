---
import friends from "../data/friends.json";
import MainGridLayout from "../layouts/MainGridLayout.astro";
---
<MainGridLayout title="友链" description="朋友们的博客">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
            <h1 class="text-3xl font-bold mb-2 text-black/90 dark:text-white/90" style="font-family: 'Noto Serif SC', serif;">友链</h1>
            <p class="text-black/50 dark:text-white/50 mb-6">我常读的博客。欢迎交换友链——给我来信就好。</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {friends.map((f) => (
                <a href={f.url} target="_blank" rel="noopener"
                   class="rounded-xl border border-black/10 dark:border-white/10 p-4 flex flex-col gap-1.5 transition hover:border-[var(--primary)] hover:translate-y-[-2px]">
                    <div class="font-bold text-black/90 dark:text-white/90">{f.name}</div>
                    <div class="text-sm text-black/60 dark:text-white/60">{f.desc}</div>
                </a>
                ))}
            </div>
            <p class="text-xs text-black/40 dark:text-white/40 mt-6">友链格式：名称 / URL / 一句话简介。收录标准：原创内容、持续更新。</p>
        </div>
    </div>
</MainGridLayout>
