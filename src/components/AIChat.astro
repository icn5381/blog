<!-- AI 聊天悬浮窗（V1 预设提示词版）：原生 JS，无框架依赖 -->
<div id="ai-chat-widget" aria-label="AI 助手">
    <button id="ai-chat-toggle" aria-label="打开 AI 助手"
        class="fixed bottom-5 right-5 z-[60] h-12 w-12 rounded-full shadow-lg flex items-center justify-center transition hover:scale-105 active:scale-95"
        style="background: var(--primary); color: white;"
        title="问 AI">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3l1.9 5.8a2 2 0 0 0 1.3 1.3L21 12l-5.8 1.9a2 2 0 0 0-1.3 1.3L12 21l-1.9-5.8a2 2 0 0 0-1.3-1.3L3 12l5.8-1.9a2 2 0 0 0 1.3-1.3z"/>
        </svg>
    </button>

    <div id="ai-chat-panel" class="hidden fixed bottom-20 right-5 z-[60] w-[min(22rem,calc(100vw-2.5rem))] rounded-2xl shadow-2xl overflow-hidden flex flex-col"
        style="background: var(--card-bg); max-height: min(30rem, 70vh);">
        <div class="px-4 py-3 flex items-center justify-between border-b border-black/10 dark:border-white/10">
            <div class="font-bold text-black/80 dark:text-white/80">站内 AI 助手</div>
            <button id="ai-chat-close" aria-label="关闭" class="text-black/40 dark:text-white/40 hover:text-black/70 dark:hover:text-white/70">✕</button>
        </div>
        <div id="ai-chat-messages" class="flex-1 overflow-y-auto px-4 py-3 flex flex-col gap-2 text-sm">
            <div class="self-start rounded-xl px-3 py-2 bg-black/5 dark:bg-white/10 text-black/70 dark:text-white/70">
                你好！我是这个博客的 AI 助手。可以问我和博客有关的问题，也可以随便聊聊。
            </div>
        </div>
        <div class="px-4 pb-1 text-[11px] text-black/35 dark:text-white/35">⚠ 提问将发送至 AI 服务处理，请勿输入敏感个人信息</div>
        <div class="p-3 flex gap-2 border-t border-black/10 dark:border-white/10">
            <input id="ai-chat-input" type="text" placeholder="输入问题，回车发送…"
                class="flex-1 rounded-lg bg-black/5 dark:bg-white/10 px-3 py-2 text-sm text-black/80 dark:text-white/80 outline-none focus:ring-2 focus:ring-[var(--primary)]" />
            <button id="ai-chat-send" class="rounded-lg px-3 py-2 text-sm text-white" style="background: var(--primary);">发送</button>
        </div>
    </div>
</div>

<script is:inline>
(() => {
    const toggle = document.getElementById('ai-chat-toggle');
    const panel = document.getElementById('ai-chat-panel');
    const closeBtn = document.getElementById('ai-chat-close');
    const messagesEl = document.getElementById('ai-chat-messages');
    const input = document.getElementById('ai-chat-input');
    const send = document.getElementById('ai-chat-send');
    if (!toggle || !panel) return;
    let history = []; // {role, content}

    const addBubble = (text, mine) => {
        const div = document.createElement('div');
        div.className = mine
            ? 'self-end rounded-xl px-3 py-2 text-white max-w-[85%] whitespace-pre-wrap'
            : 'self-start rounded-xl px-3 py-2 bg-black/5 dark:bg-white/10 text-black/70 dark:text-white/70 max-w-[85%] whitespace-pre-wrap';
        if (mine) div.style.background = 'var(--primary)';
        div.textContent = text;
        messagesEl.appendChild(div);
        messagesEl.scrollTop = messagesEl.scrollHeight;
        return div;
    };

    const sendMsg = async () => {
        const q = input.value.trim();
        if (!q) return;
        input.value = '';
        addBubble(q, true);
        history.push({ role: 'user', content: q });
        const botBubble = addBubble('…', false);
        try {
            const res = await fetch('/api/chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ messages: history }),
            });
            if (!res.ok) {
                let msg = 'AI 服务暂时不可用';
                try { msg = (await res.json()).error || msg; } catch {}
                botBubble.textContent = msg;
                return;
            }
            if (!res.body) { botBubble.textContent = 'AI 服务暂时不可用'; return; }
            const reader = res.body.getReader();
            const decoder = new TextDecoder();
            let acc = '';
            while (true) {
                const { done, value } = await reader.read();
                if (done) break;
                acc += decoder.decode(value, { stream: true });
                botBubble.textContent = acc;
                messagesEl.scrollTop = messagesEl.scrollHeight;
            }
            history.push({ role: 'assistant', content: acc });
        } catch (e) {
            botBubble.textContent = '网络出错了，稍后再试（本地预览时 AI 需部署后可用）';
        }
    };

    toggle.addEventListener('click', () => { panel.classList.toggle('hidden'); if (!panel.classList.contains('hidden')) input.focus(); });
    closeBtn.addEventListener('click', () => panel.classList.add('hidden'));
    send.addEventListener('click', sendMsg);
    input.addEventListener('keydown', (e) => { if (e.key === 'Enter') sendMsg(); });
})();
</script>
